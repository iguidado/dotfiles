# All Vagrant configuration is done below. The "2" in Vagrant.configure
# configures the configuration version (we support older styles for
# backwards compatibility). Please don't change it unless you know what
# you're doing.
# Parcours de test appliqué à l'identique aux trois cibles : c'est la seule
# façon de vérifier qu'un même bootstrap tient sur Debian, Ubuntu et Alpine.
#
#   1. `file`   téléverse le bootstrap LOCAL. Le synced folder est désactivé
#               volontairement, c'est donc le seul moyen d'exercer le code du
#               working tree plutôt que celui déjà poussé sur GitHub.
#   2. `shell`  l'exécute avec privileged: false -- les provisioners shell de
#               Vagrant tournent en root par défaut, or bootstrap.sh refuse
#               explicitement de s'exécuter en root (check_root).
#   3. `ansible` rejoue le playbook LOCAL contre l'invité. `dotfiles_repo_dir`
#               doit être surchargé : le playbook le déduit de `playbook_dir`,
#               qui est un chemin du CONTRÔLEUR, pas de la cible.
#
# LIMITE CONNUE : bootstrap.sh clone le dépôt depuis GitHub, donc le contenu de
# Srcs/ effectivement stowé est celui de la branche distante. Pousse tes
# changements avant de tester une modification de dotfile ; les modifications
# de bootstrap.sh et des playbooks, elles, sont bien prises depuis le local.

# Le playbook cible `hosts: dotfiles`, pas `all`. Or l'inventaire que le
# provisioner ansible de Vagrant génère ne range les invités dans AUCUN groupe
# nommé : sans la déclaration ci-dessous, le play ne matcherait plus rien et
# Vagrant rapporterait un succès (play skipped, rc=0) sans avoir rien déployé.
# La liste doit donc suivre celle des VMs définies plus bas ; Vagrant ignore
# les membres qui ne sont pas dans l'inventaire du moment, une VM non démarrée
# ne pose donc pas de problème.
VM_NAMES = ["web_ubuntu", "mini_alpine", "web_debian"]

ANSIBLE_GROUPS = {
  "dotfiles" => VM_NAMES
}

# Même raison pour le playbook privilégié : il cible désormais `hosts:
# containers` (il tournait avant en `hosts: all`, et ne marchait donc ici que
# par effet de bord). Sans ce groupe, `vagrant provision --provision-with
# containers` ne matcherait plus rien et rapporterait un succès sans rien faire.
CONTAINER_GROUPS = {
  "containers" => VM_NAMES
}

def provision_userland(vm)
  vm.provision "file",
    source: "../bootstrap.sh",
    destination: "/home/vagrant/bootstrap.sh"

  vm.provision "shell",
    privileged: false,
    inline: "chmod +x /home/vagrant/bootstrap.sh && /home/vagrant/bootstrap.sh"

  vm.provision "dotfiles", type: "ansible" do |a|
    a.playbook = "../ansible/dotfiles.yml"
    a.compatibility_mode = "2.0"
    a.groups = ANSIBLE_GROUPS
    a.extra_vars = { dotfiles_repo_dir: "/home/vagrant/dotfiles" }
  end

  # Playbook privilégié, hors du périmètre userland : ne tourne jamais seul.
  #   vagrant provision --provision-with containers
  vm.provision "containers", type: "ansible", run: "never" do |a|
    a.playbook = "../ansible/container_base.yml"
    a.compatibility_mode = "2.0"
    a.groups = CONTAINER_GROUPS
  end
end

Vagrant.configure("2") do |config|
  # The most common configuration options are documented and commented below.
  # For a complete reference, please see the online documentation at
  # https://docs.vagrantup.com.
  #
  # Disabling synced folder since it is not needed for tests
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Every Vagrant development environment requires a box. You can search for
  # boxes at https://vagrantcloud.com/search.
  config.vm.define "web_ubuntu" do |ubuntu|
    ubuntu.vm.box = "generic/ubuntu2204"
    ubuntu.vm.network "private_network", ip: "192.168.56.10"
    provision_userland(ubuntu.vm)
  end

  config.vm.define "mini_alpine" do |alpine|
    alpine.vm.box = "generic/alpine319"
    alpine.vm.network "private_network", ip: "192.168.56.11"
    provision_userland(alpine.vm)
  end

  config.vm.define "web_debian" do |debian|
    debian.vm.box = "debian/bookworm64"
    debian.vm.network "private_network", ip: "192.168.56.12"
    provision_userland(debian.vm)
  end
end

  # Disable automatic box update checking. If you disable this, then
  # boxes will only be checked for updates when the user runs
  # `vagrant box outdated`. This is not recommended.
  # config.vm.box_check_update = false

  # Create a forwarded port mapping which allows access to a specific port
